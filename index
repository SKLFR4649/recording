    $('sumStatus').className = 'status';
  });

  // ---------- 錄完再轉：Gemini 音訊轉寫 ----------
  let transcribing = false;
  function txMsg(msg, kind){
    const el = $('txStatus');
    if (!msg) { el.hidden = true; el.innerHTML = ''; return; }
    el.hidden = false; el.className = 'txstatus' + (kind === 'err' ? ' err' : '');
    el.innerHTML = (kind === 'busy' ? '<span class="spin"></span>' : '') + '<span></span>';
    el.lastChild.textContent = msg;
  }
  const GEM = 'https://generativelanguage.googleapis.com';
  function audioMime(blob){
    let t = (blob.type || '').split(';')[0].toLowerCase();
    const name = (blob.name || '').toLowerCase();
    if (!t) t = name.endsWith('.mp3') ? 'audio/mpeg' : name.endsWith('.wav') ? 'audio/wav' : name.endsWith('.m4a') ? 'audio/m4a' : name.endsWith('.ogg') ? 'audio/ogg' : 'audio/webm';
    if (t === 'audio/mp4' || t === 'audio/x-m4a') t = 'audio/m4a';
    if (t === 'audio/x-wav' || t === 'audio/wave') t = 'audio/wav';
    if (t === 'audio/mp3') t = 'audio/mpeg';
    return t;
  }
  const toBase64 = blob => new Promise((ok, fail) => { const r = new FileReader(); r.onload = () => ok(String(r.result).split(',')[1]); r.onerror = () => fail(new Error('讀取錄音檔失敗')); r.readAsDataURL(blob); });
  const sleep = ms => new Promise(r => setTimeout(r, ms));

  async function uploadToGemini(blob, mime, key, onStep){
    onStep('正在上傳錄音檔到 Gemini…');
    const start = await fetch(GEM + '/upload/v1beta/files', {
      method: 'POST',
      headers: { 'x-goog-api-key': key, 'X-Goog-Upload-Protocol': 'resumable', 'X-Goog-Upload-Command': 'start',
        'X-Goog-Upload-Header-Content-Length': String(blob.size), 'X-Goog-Upload-Header-Content-Type': mime, 'Content-Type': 'application/json' },
      body: JSON.stringify({ file: { display_name: 'meeting-audio' } })
    });
    if (!start.ok) { const d = await start.json().catch(() => ({})); throw new Error(d?.error?.message || '上傳失敗（HTTP ' + start.status + '）'); }
    const url = start.headers.get('x-goog-upload-url');
    if (!url) throw new Error('瀏覽器擋下了大檔上傳，請改用 20 MB 以下的錄音檔');
    const up = await fetch(url, { method: 'POST', headers: { 'X-Goog-Upload-Offset': '0', 'X-Goog-Upload-Command': 'upload, finalize' }, body: blob });
    const j = await up.json().catch(() => ({}));
    if (!up.ok || !j.file) throw new Error(j?.error?.message || '上傳失敗（HTTP ' + up.status + '）');
    let file = j.file;
    for (let i = 0; file.state === 'PROCESSING' && i < 100; i++) {
      onStep('Gemini 正在處理錄音檔…');
      await sleep(3000);
      const r = await fetch(GEM + '/v1beta/' + file.name, { headers: { 'x-goog-api-key': key } });
      file = await r.json();
    }
    if (file.state !== 'ACTIVE') throw new Error('Gemini 無法處理這個錄音檔');
    return { file_data: { mime_type: file.mimeType || mime, file_uri: file.uri } };
  }

  function transcribePrompt(){
    const lang = $('lang').value;
    const langNote = lang === 'cmn-Hans-CN' ? '中文請使用简体字。' : lang === 'en-US' ? 'Transcribe English speech in English.' : lang === 'ja-JP' ? '日本語の発言は日本語で書き起こしてください。' : '中文請使用繁體字（台灣用語）；夾雜的英文保留原文。';
    const who = $('attendees').value.trim();
    return `請把這段會議錄音完整轉寫成逐字稿。
規則：
1. 逐句輸出，每行一句，格式固定為：[HH:MM:SS] 說話者：內容
2. 時間是該句在錄音中開始的時間。
3. 依聲音區分不同說話者，標示為「說話者A」「說話者B」…；若從對話內容能確定是誰，可直接用姓名或稱謂。${who ? '\n   與會者名單供參考：' + who : ''}
4. 忠實轉寫，不要摘要、不要省略、不要潤飾；去掉「嗯」「呃」等無意義的語助詞即可。聽不清楚的地方寫（聽不清）。
5. ${langNote}
6. 只輸出逐字稿本身，不要加標題、說明或 Markdown 符號。`;
  }

  async function transcribeAudio(blob){
    if (!blob || transcribing) return;
    const key = geminiKey();
    if (!key) {
      txMsg('需要 Gemini API Key 才能轉逐字稿。請在右側「AI 服務設定」選 Gemini 並填入金鑰，再按「用 Gemini 轉逐字稿」。', 'err');
      $('cfg').open = true; $('provider').value = 'gemini'; $('provider').dispatchEvent(new Event('change'));
      setState(state); return;
    }
    const model = (store.get('model_gemini') || PROVIDERS.gemini.model).trim();
    transcribing = true; setState(state);
    const t0 = Date.now(); let step = '準備中…';
    const timer = setInterval(() => txMsg(`${step}（已等待 ${Math.round((Date.now()-t0)/1000)} 秒，一小時的錄音約需 1–3 分鐘）`, 'busy'), 1000);
    const onStep = s => { step = s; txMsg(`${step}（已等待 ${Math.round((Date.now()-t0)/1000)} 秒）`, 'busy'); };
    try {
      const mime = audioMime(blob);
      let part;
      if (blob.size < 14 * 1024 * 1024) { onStep('正在讀取錄音檔…'); part = { inline_data: { mime_type: mime, data: await toBase64(blob) } }; }
      else part = await uploadToGemini(blob, mime, key, onStep);
      onStep(`Gemini（${model}）正在轉寫逐字稿…`);
      const res = await fetch(`${GEM}/v1beta/models/${encodeURIComponent(model)}:generateContent`, {
        method: 'POST',
        headers: { 'content-type': 'application/json', 'x-goog-api-key': key },
        body: JSON.stringify({ contents: [{ role: 'user', parts: [part, { text: transcribePrompt() }] }], generationConfig: { maxOutputTokens: 65536, temperature: 0.2 } })
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data?.error?.message || ('HTTP ' + res.status));
      const cand = (data.candidates || [])[0];
      const text = (cand?.content?.parts || []).map(p => p.text || '').join('').trim();
      if (!text) throw new Error(data?.promptFeedback?.blockReason ? '內容被安全過濾擋下' : '模型沒有回傳內容，可能是錄音中沒有可辨識的語音');
      const parsed = parseLines(text);
      if (!parsed.length) throw new Error('沒有轉出任何文字');
