      elapsed = Math.max(elapsed, parsed[parsed.length-1].t);
      summaryMd = ''; store.set('summary', ''); renderSummary();
      transcribing = false; renderClock(); renderTranscript();
      const partial = cand?.finishReason === 'MAX_TOKENS';
      txMsg(partial ? `轉寫完成 ${parsed.length} 句，但錄音太長，結尾部分可能被截斷。` : `轉寫完成，共 ${parsed.length} 句。可以點文字修正，再按「用 AI 產生摘要」。`, partial ? 'err' : '');
      status('逐字稿已完成，可以產生摘要了。');
    } catch(e) {
      transcribing = false;
      txMsg('轉逐字稿失敗：' + e.message + '。錄音仍保留著，可以按「下載錄音」存檔，或稍後再按「用 Gemini 轉逐字稿」重試。', 'err');
    } finally {
      clearInterval(timer); transcribing = false; setState(state);
    }
  }

  $('btnTranscribe').addEventListener('click', () => transcribeAudio(audioBlob));
  $('btnUpload').addEventListener('click', () => $('audioFile').click());
  $('audioFile').addEventListener('change', () => {
    const f = $('audioFile').files[0]; $('audioFile').value = '';
    if (!f) return;
    audioBlob = f; elapsed = 0; segs = []; renderClock(); renderTranscript();
    $('btnDlAudio').disabled = false;
    transcribeAudio(f);
  });

  // 新會議：兩段式確認
  let newArmed = null;
  $('btnNew').addEventListener('click', () => {
    if (!segs.length && !summaryMd) return reset();
    if (newArmed) { clearTimeout(newArmed); newArmed=null; $('btnNew').textContent='新會議'; return reset(); }
    $('btnNew').textContent = '再按一次清除目前內容';
