        if (laterMode) transcribeAudio(audioBlob);
      };
      mediaRec.start(1000);
    } catch(e) {
      mediaRec = null;
      if (laterMode) { stream.getTracks().forEach(t => t.stop()); showSupport('這個瀏覽器無法錄音，請改用 Edge、Chrome 或 Safari。'); return; }
    }
    keepAwake(true);
    startedAt = Date.now();
    setState('rec');
    renderTranscript();
    startRecognition();
    startMeter();
    tick = setInterval(renderClock, 250);
  });

  $('btnPause').addEventListener('click', () => {
    if (state === 'rec') {
      elapsed = now(); setState('paused');
      stopRecognition();
      if (mediaRec && mediaRec.state === 'recording') mediaRec.pause();
    } else if (state === 'paused') {
      startedAt = Date.now(); setState('rec');
      if (mediaRec && mediaRec.state === 'paused') mediaRec.resume();
