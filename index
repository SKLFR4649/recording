  $('btnCopyPrompt').addEventListener('click', e => {
    if (!segs.length) return status('目前還沒有逐字稿內容。', true);
    copy(buildPrompt(), e.currentTarget);
    status('已複製。打開 Claude 對話貼上送出，就會得到整理好的會議記錄。');
  });

  function status(msg, err){ $('sumStatus').textContent = msg; $('sumStatus').className = 'status' + (err?' err':''); }

  $('btnGen').addEventListener('click', async () => {
    if (!segs.length) return status('目前還沒有逐字稿內容。', true);
    const provider = $('provider').value, cfg = PROVIDERS[provider];
    const key = $('apikey').value.trim();
    const model = $('model').value.trim() || cfg.model;
    if (!key) { $('cfg').open = true; $('apikey').focus(); return status(`請先在設定中填入 ${cfg.name} API Key，或改用「複製摘要指令」貼到 AI 對話。`, true); }
    const btn = $('btnGen'); btn.disabled = true; status(`正在用 ${cfg.name} 產生摘要…`);
    try {
      let text = '';
      if (provider === 'gemini') {
        const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(model)}:generateContent`, {
          method: 'POST',
          headers: { 'content-type': 'application/json', 'x-goog-api-key': key },
          body: JSON.stringify({ contents: [{ role: 'user', parts: [{ text: buildPrompt() }] }], generationConfig: { maxOutputTokens: 8000 } })
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data?.error?.message || ('HTTP ' + res.status));
        const cand = (data.candidates || [])[0];
        text = (cand?.content?.parts || []).map(p => p.text || '').join('').trim();
        if (!text) throw new Error(data?.promptFeedback?.blockReason ? '內容被安全過濾擋下（' + data.promptFeedback.blockReason + '）' : '模型沒有回傳內容');
      } else {
        const res = await fetch('https://api.anthropic.com/v1/messages', {
          method: 'POST',
          headers: {
            'content-type': 'application/json',
            'x-api-key': key,
            'anthropic-version': '2023-06-01',
            'anthropic-dangerous-direct-browser-access': 'true'
          },
          body: JSON.stringify({ model, max_tokens: 4000, messages: [{ role: 'user', content: buildPrompt() }] })
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data?.error?.message || ('HTTP ' + res.status));
        text = (data.content || []).filter(c => c.type === 'text').map(c => c.text).join('\n').trim();
      }
      summaryMd = text;
      store.set('summary', summaryMd); renderSummary();
      status('摘要已產生，可以按「編輯」修改內容。');
    } catch(e) {
      status('產生失敗：' + e.message + '。請確認 API Key 與模型名稱是否正確、網路是否連線。', true);
    } finally { btn.disabled = false }
  });

  // 簡易 Markdown 轉換
  function md(src){
    const esc = s => s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    const inline = s => esc(s).replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>').replace(/`(.+?)`/g,'<code>$1</code>');
    let html = '', inList = false;
    for (const raw of src.split('\n')) {
      const line = raw.trimEnd();
      const h = line.match(/^(#{1,4})\s+(.*)/);
      const li = line.match(/^\s*(?:[-*]|\d+\.)\s+(.*)/);
      if (li) { if (!inList) { html += '<ul>'; inList = true } html += '<li>' + inline(li[1]) + '</li>'; continue }
      if (inList) { html += '</ul>'; inList = false }
      if (h) html += `<h${Math.min(3,h[1].length+1)}>${inline(h[2])}</h${Math.min(3,h[1].length+1)}>`;
      else if (line.trim()) html += '<p>' + inline(line) + '</p>';
    }
    if (inList) html += '</ul>';
    return html;
  }
  function renderSummary(){
    if (summaryMd) $('summaryView').innerHTML = md(summaryMd);
    else $('summaryView').innerHTML = '<p class="hint">結束錄音後按「用 AI 產生摘要」，會整理出：會議摘要、討論重點、決議事項、待辦事項（負責人／期限）、待確認問題。</p>';
  }
  let editing = false;
  $('btnToggleEdit').addEventListener('click', () => {
    editing = !editing;
    if (editing) { $('summaryEdit').value = summaryMd; $('summaryEdit').hidden = false; $('summaryView').hidden = true; $('btnToggleEdit').textContent = '完成'; $('summaryEdit').focus(); }
    else { summaryMd = $('summaryEdit').value; store.set('summary', summaryMd); $('summaryEdit').hidden = true; $('summaryView').hidden = false; $('btnToggleEdit').textContent = '編輯'; renderSummary(); }
  });
  $('summaryEdit').addEventListener('input', () => { summaryMd = $('summaryEdit').value; store.set('summary', summaryMd) });
  $('btnCopySum').addEventListener('click', e => copy(summaryMd || '', e.currentTarget));
  $('btnDlMd').addEventListener('click', () => {
    const doc = `# ${$('title').value || '會議記錄'}\n\n- 日期：${$('mdate').value}\n- 與會者：${$('attendees').value || '（未填）'}\n- 會議長度：${fmt(elapsed)}\n\n${summaryMd || '（尚未產生摘要）'}\n\n---\n\n## 附錄：逐字稿\n\n${segs.map(s => `**[${fmt(s.t)}]** ${s.text}  `).join('\n')}\n`;
    download(safeName() + '_會議記錄.md', new Blob(['﻿' + doc], {type:'text/markdown;charset=utf-8'}));
  });

  window.addEventListener('beforeunload', e => { if (state !== 'idle') { e.preventDefault(); e.returnValue = '' } });

  setState('idle'); renderClock(); renderTranscript(); renderSummary(); updateNotice();
})();
</script>
