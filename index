  }
  const header = () => `會議名稱：${$('title').value||'（未命名）'}\n日期：${$('mdate').value}\n與會者：${$('attendees').value||'（未填）'}\n`;

  $('btnCopyTx').addEventListener('click', e => copy(transcriptText(), e.currentTarget));
  $('btnDlTx').addEventListener('click', () => download(safeName()+'_逐字稿.txt', new Blob(['﻿'+header()+'\n'+transcriptText()], {type:'text/plain;charset=utf-8'})));
  $('btnDlAudio').addEventListener('click', () => { if (audioBlob) download(safeName()+'_錄音.'+(audioBlob.type.includes('ogg')?'ogg':'webm'), audioBlob) });

  // ---------- 摘要 ----------
  function buildPrompt(){
    return `你是專業的會議記錄秘書。請根據以下會議逐字稿，用繁體中文整理成正式的會議記錄。
逐字稿由語音辨識產生，可能有錯字、同音字或斷句錯誤，請依上下文合理理解，但不要捏造逐字稿中沒有的內容。

請用 Markdown 輸出，依序包含以下段落：
## 會議摘要
（3–5 句說明會議目的與整體結論）
