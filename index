  });
  // 把「[00:01:23] 內容」格式的文字拆成逐字稿；沒有時間的行每句往後推 8 秒
  function parseLines(text){
    let last = 0;
    return text.split(/\r?\n/).map(l => l.trim()).filter(l => l && !l.startsWith('```')).map(l => {
      const m = l.match(/^\**\[?(\d{1,2}):(\d{2})(?::(\d{2}))?\]?\**\s*[-–:：]?\s*(.*)$/);
      if (m && m[4]) { const t = m[3] !== undefined ? (+m[1])*3600 + (+m[2])*60 + (+m[3]) : (+m[1])*60 + (+m[2]); last = t; return { t, text: m[4] } }
      last += 8; return { t: last, text: l };
    });
  }

  $('btnSample').addEventListener('click', () => {
    loadSample(); renderClock(); renderTranscript(); renderSummary();
    status('已載入範例逐字稿，按「用 AI 產生摘要」測試整理效果。');
  });
  $('btnImport').addEventListener('click', () => { $('importBox').hidden = !$('importBox').hidden; if (!$('importBox').hidden) $('importText').focus(); });
  $('btnImportCancel').addEventListener('click', () => { $('importBox').hidden = true });
  $('btnImportOk').addEventListener('click', () => {
    const parsed = parseLines($('importText').value);
    if (!parsed.length) return;
    segs = parsed;
    elapsed = parsed[parsed.length-1].t; summaryMd = ''; store.set('summary','');
    saveSegs(); $('importBox').hidden = true; $('importText').value = '';
    renderClock(); renderTranscript(); renderSummary();
    status(`已匯入 ${segs.length} 句，按「用 AI 產生摘要」開始整理。`);
  });

  function reset(){
    segs = []; saveSegs(); elapsed = 0; audioBlob = null; summaryMd = ''; store.set('summary','');
    $('title').value=''; store.set('title','');
    $('mdate').value = new Date().toISOString().slice(0,10); store.set('date',$('mdate').value);
    $('btnDlAudio').disabled = true; $('btnNew').textContent='新會議';
    renderClock(); renderTranscript(); renderSummary();
    $('sumStatus').textContent='';
  }

  // ---------- 匯出 ----------
  const safeName = () => (($('title').value.trim() || '會議') + '_' + $('mdate').value).replace(/[\\/:*?"<>|]/g,'_');
  const transcriptText = () => segs.map(s => `[${fmt(s.t)}] ${s.text}`).join('\n');
  function download(name, blob){
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = name;
    document.body.appendChild(a); a.click(); setTimeout(() => { URL.revokeObjectURL(a.href); a.remove() }, 2000);
  }
  async function copy(text, btn){
    const old = btn.textContent;
    try { await navigator.clipboard.writeText(text); btn.textContent='已複製' }
    catch(e){
      const ta=document.createElement('textarea'); ta.value=text; document.body.appendChild(ta); ta.select();
      try{ document.execCommand('copy'); btn.textContent='已複製' }catch(_){ btn.textContent='複製失敗' } ta.remove();
